{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:local": "DOGGY_SERVER_ENV_TARGET=LOCAL node --watch src/server.js",
    "dev:railway": "DOGGY_SERVER_ENV_TARGET=RAILWAY_DB DOGGY_SERVER_ENV_FILE=.env.railway.local node --watch src/server.js",
    "build": "prisma generate",
    "start": "prisma migrate deploy && node src/server.js",
    "seed:products": "node src/db/seeds/products.seed.js",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "test": "npm run tiertest1 && npm run tiertest2 && npm run tiertest3",
    "tiertest1": "vitest run tests/tier1",
    "tiertest2": "vitest run tests/tier2",
    "tiertest3": "vitest run tests/tier3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "pg": "^8.20.0",
    "prisma": "^6.16.2",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
